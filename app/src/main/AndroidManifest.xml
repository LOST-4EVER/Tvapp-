<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The app is primarily a TV/TV-box experience driven by a D-pad, but it also
      runs well on phones and tablets. touchscreen is therefore not required, so
      the app can be installed on Android TV boxes and leanback devices.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Required to install an in-app downloaded update. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Needed on Android 11+ so the updater can tell whether an update exists. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <!--
          Start.io (StartApp) ad SDK.

          SPLASH_ENABLED=false disables the SDK's full-screen "return ad" on launch.
          The app has its own navigation and its own update flow, and a second,
          uncontrolled full-screen surface on the way in is not something this
          product wants; the initialiser also passes setReturnAdsEnabled(false).

          The remaining permissions the SDK needs (INTERNET, ACCESS_NETWORK_STATE,
          ACCESS_WIFI_STATE, RECEIVE_BOOT_COMPLETED, AD_ID and ACCESS_ADSERVICES_TOPICS)
          are declared by the SDK's own manifest and merged in, so they are
          deliberately not repeated here.
        -->
        <provider
            android:name="com.startapp.sdk.adsbase.StartAppInitProvider"
            tools:node="remove" />

        <meta-data
            android:name="com.startapp.sdk.SPLASH_ENABLED"
            android:value="false" />

        <!--
          The Privacy Sandbox Topics configuration the SDK expects on Android 13+.
          The element is ignored below API 31, hence the tools:targetApi annotation.
        -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/ad_services_config"
            tools:targetApi="s" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:banner="@drawable/ic_tv_banner"
            android:windowSoftInputMode="adjustResize">
            <!--
              Two filters, not one.

              LEANBACK_LAUNCHER is what puts the app on the Android TV home screen.
              It was missing, so the manifest below declared the leanback feature
              and the UI was built for a D-pad, but on an actual television the app
              could only be started from the app drawer of a launcher that happened
              to list non-TV activities — and on stock Android TV, which is the
              common case, there is no such list. The app was effectively
              unlaunchable on the device it is designed for.

              Both categories stay on the same filter so one install serves phones,
              tablets and televisions.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.software.leanback.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Exposes a downloaded update APK to the system package installer as a
          content:// URI. A file:// URI is rejected on Android 7+.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.aistudio.kurdishtv.live.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
