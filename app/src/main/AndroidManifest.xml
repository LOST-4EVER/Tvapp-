<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The app is primarily a TV/TV-box experience driven by a D-pad, but it also
      runs well on phones and tablets. touchscreen is therefore not required, so
      the app can be installed on Android TV boxes and leanback devices.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Required to install an in-app downloaded update. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Needed on Android 11+ so the updater can tell whether an update exists. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:banner="@drawable/ic_tv_banner"
            android:windowSoftInputMode="adjustResize">
            <!--
              Two filters, not one.

              LEANBACK_LAUNCHER is what puts the app on the Android TV home screen.
              It was missing, so the manifest below declared the leanback feature
              and the UI was built for a D-pad, but on an actual television the app
              could only be started from the app drawer of a launcher that happened
              to list non-TV activities — and on stock Android TV, which is the
              common case, there is no such list. The app was effectively
              unlaunchable on the device it is designed for.

              Both categories stay on the same filter so one install serves phones,
              tablets and televisions.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.software.leanback.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The Tv Input Framework tuner.

          This is what makes the app's channels reachable from the *system* Live TV
          app (Google TV, or an OEM tuner): it appears in the system's list of input
          sources, its channels appear in the system channel picker, and choosing one
          starts a session here that plays it.

          Three things about it are load-bearing:

          - `android:permission="android.permission.BIND_TV_INPUT"`. This is a
            signature-level permission held only by the system, and it is what stops
            any other app on the device from binding the service and using the app's
            tuner as a proxy.
          - `android:exported="true"`. Required, and it looks contradictory next to
            the permission above. The system is a different UID, so it must be able
            to bind; the permission is what makes that safe.
          - The `<meta-data>` block. Without it the service is never discovered as a
            TV input, and the only symptom is an app that does not appear in the
            tuner's list.

          The class name is fully qualified on purpose. A relative `android:name`
          resolves against the namespace, and a service that fails to resolve is not
          a compile error — it is a class that does not exist at runtime, a tuner
          that silently never appears, and nothing in the build saying so.
        -->
        <service
            android:name="com.example.tuner.KurdishTvInputService"
            android:exported="true"
            android:label="@string/tv_input_tuner_label"
            android:permission="android.permission.BIND_TV_INPUT">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>

            <meta-data
                android:name="android.media.tv.input.TvInputService"
                android:resource="@xml/tv_input_tuner_info" />
        </service>

        <!--
          Exposes a downloaded update APK to the system package installer as a
          content:// URI. A file:// URI is rejected on Android 7+.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.aistudio.kurdishtv.live.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
