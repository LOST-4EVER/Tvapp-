<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only the launcher background is left.

      The purple/teal/black/white entries were the Android Studio project template's
      default palette, and nothing in this app referenced any of them: the theme in
      themes.xml uses @android:color/black and @android:color/transparent, and every
      colour the UI draws comes from the Compose theme in ui/theme. `isShrinkResources`
      would have dropped them from the release APK, but they were still in the source
      tree for anyone reading it as "this app's colours", which is the opposite of
      true — the app's colours are in Kotlin.
    -->
    <color name="ic_launcher_background">#151821</color>
</resources>
