<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground.

  The art is kept inside the centre 72dp of the 108dp canvas, which is the region
  Android guarantees is visible once the launcher applies its mask. Art that spills
  outside that safe zone gets clipped by round, squircle and squircle-shaped masks,
  which is what made the previous icon look cut off.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="72dp"
        android:height="72dp"
        android:drawable="@drawable/ic_launcher_art"
        android:gravity="center" />
</layer-list>
