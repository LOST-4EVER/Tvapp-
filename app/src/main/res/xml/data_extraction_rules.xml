<?xml version="1.0" encoding="utf-8"?><!--
   Backup / device-transfer rules for Android 12+ (API 31+).
   Only preferences (settings, favorites, watch history, custom playlists) are
   carried over. The cached channel list is excluded so a restore always
   re-downloads a fresh one instead of resurrecting a stale snapshot.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="cached_kurdish_channels.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="cached_kurdish_channels.json" />
    </device-transfer>
</data-extraction-rules>
