<?xml version="1.0" encoding="utf-8"?>
<!--
  Tv Input Framework descriptor for this app's tuner.

  The system Live TV app reads this when the viewer picks an input source, and it is
  what decides whether the app appears in that list at all. A TvInputService with no
  descriptor is ignored, which looks exactly like a bug in the service itself.

  Only `settingsActivity` is set. The capability attributes this descriptor used to
  carry — supportsTuning, supportsRecording, supportsPauseAndProgramGuide — are no
  longer part of the schema, and naming one is a hard resource-linking failure
  rather than a warning, so the declaration is simply what the current schema
  accepts.

  That is not a loss here. What a tuner can do is no longer declared in metadata;
  it is declared by what the session does when asked. This tuner plays the URI it
  is handed and answers false to anything else, which is the same statement the
  old flags used to make.
-->
<tv-input xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.example.MainActivity">
    <display name="@string/tv_input_tuner_label" />
    <device name="@string/tv_input_tuner_device" />
</tv-input>
