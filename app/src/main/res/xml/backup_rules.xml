<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and below (API <= 30).
   The app stores nothing sensitive: preferences, favorites, recents and the
   cached channel list. Backup is limited to preferences, and the on-disk
   channel cache is excluded so a restore never resurrects a stale list.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="file" path="cached_kurdish_channels.json" />
</full-backup-content>
